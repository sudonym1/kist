<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <DefineConstants>$(DefineConstants);SHAREDINVENTORY_TESTING</DefineConstants>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(BepInExDir)/core/Mono.Cecil.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)/Newtonsoft.Json.dll" />
    <Compile Include="../../src/RpcApi.cs" Link="RpcApi.cs" />
    <Compile Include="../../src/ChestAccess.cs" Link="ChestAccess.cs" />
    <Compile Include="../../src/ChestCoverage.cs" Link="ChestCoverage.cs" />
    <Compile Include="../../src/ContentIds.cs" Link="ContentIds.cs" />
    <Compile Include="../../src/Replies.cs" Link="Replies.cs" />
    <Compile Include="../../src/CountDatabase.cs" Link="CountDatabase.cs" />
    <Compile Include="../../src/DatabaseFile.cs" Link="DatabaseFile.cs" />
    <Compile Include="../../src/Worker.cs" Link="Worker.cs" />
    <Compile Include="../../src/Testing/TestHarness.cs" Link="Testing/TestHarness.cs" />
  </ItemGroup>
</Project>
