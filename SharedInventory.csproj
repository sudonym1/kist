<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Build.local.props" Condition="Exists('Build.local.props')" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SharedInventory</AssemblyName>
    <Title>Einherjar Chest</Title>
    <AssemblyTitle>Einherjar Chest</AssemblyTitle>
    <Product>Einherjar Chest</Product>
    <Version>0.4.1</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableTestHarness Condition="'$(EnableTestHarness)' == ''">false</EnableTestHarness>
    <DefineConstants Condition="'$(EnableTestHarness)' == 'true'">$(DefineConstants);SHAREDINVENTORY_TESTING</DefineConstants>
    <OutputPath Condition="'$(EnableTestHarness)' == 'true'">bin/$(Configuration)/testing/</OutputPath>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Remove="src/Testing/**/*.cs" Condition="'$(EnableTestHarness)' != 'true'" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set -p:ValheimDir to your Valheim install, or -p:ManagedDir to its Managed folder." />
    <Error Condition="!Exists('$(BepInExDir)/core/BepInEx.dll')" Text="Set -p:BepInExDir to your BepInEx folder (a mod-manager profile is fine)." />
  </Target>
</Project>
